[sub_resource type="Shader" id="Shader_background"]
code = "shader_type canvas_item;

uniform vec2 cursor_position = vec2(0.5, 0.5);

float hash(vec2 coordinates) {
	return fract(sin(dot(coordinates, vec2(127.1, 311.7))) * 43758.5453123);
}

void fragment() {
	vec2 uv = UV;
	vec2 centred_uv = uv - vec2(0.5);
	float aspect = SCREEN_PIXEL_SIZE.y / SCREEN_PIXEL_SIZE.x;
	centred_uv.x *= aspect;
	float animation_time = TIME;

	vec3 colour = mix(vec3(0.008, 0.019, 0.040), vec3(0.018, 0.043, 0.078), uv.y);
	float cyan_glow = exp(-6.0 * length(centred_uv - vec2(0.24, -0.12)));
	float violet_glow = exp(-8.0 * length(centred_uv - vec2(0.12, 0.43)));
	colour += vec3(0.02, 0.34, 0.46) * cyan_glow * 0.5;
	colour += vec3(0.19, 0.06, 0.38) * violet_glow * 0.42;

	vec2 grid_uv = uv * vec2(30.0, 17.0);
	grid_uv.x += sin(uv.y * 3.0 + animation_time * 0.05) * 0.16;
	vec2 grid_distance = abs(fract(grid_uv) - 0.5) / fwidth(grid_uv);
	float grid_line = 1.0 - min(min(grid_distance.x, grid_distance.y), 1.0);
	colour += vec3(0.12, 0.58, 0.72) * grid_line * 0.026;

	float wave = sin((centred_uv.x * 3.1 + centred_uv.y * 1.2) * 8.0 - animation_time * 0.26);
	float ribbon = exp(-85.0 * abs(centred_uv.y + 0.24 + wave * 0.012));
	colour += vec3(0.18, 0.68, 0.82) * ribbon * 0.07;

	vec2 star_cell = floor(uv * vec2(160.0, 90.0));
	float star = step(0.988, hash(star_cell));
	float twinkle = 0.45 + 0.55 * sin(animation_time * 0.8 + hash(star_cell + 4.0) * 6.2831);
	colour += vec3(0.40, 0.79, 0.94) * star * twinkle * 0.14;

	vec2 cursor_delta = uv - cursor_position;
	cursor_delta.x *= aspect;
	colour += vec3(0.05, 0.45, 0.62) * exp(-25.0 * length(cursor_delta)) * 0.12;
	float vignette = 1.0 - smoothstep(0.35, 0.88, length(centred_uv * vec2(0.78, 1.0)));
	colour *= 0.62 + 0.38 * vignette;
	COLOR = vec4(colour, 1.0);
}"

